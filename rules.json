    "ZXGD": "《公开募集证券投资基金宣传推介材料管理暂行规定》（中国证监会公告〔2020〕59号，2020-10-01 施行）。已对照官方原文核对条款号，description 仍为转述，待合规顾问复核。",
    "XSBF": "《公开募集证券投资基金销售机构监督管理办法》（中国证监会令第175号，2020-10-01 施行）。",
    "GGF": "《中华人民共和国广告法》第九条（绝对化用语）。"
  },
  "note": "description 为条款转述，不是原文；上线前须由合规人员按原文复核。check: keyword=关键词初筛即可提示, llm=需模型判断, manual=需文本以外的信息。",
  "rules": [
    {
      "id": "R01",
      "source": "ZXGD",
      "article": "第四条第一款",
      "title": "成立不足 6 个月展示业绩",
      "description": "基金合同生效不足 6 个月的，不得展示该基金的过往业绩。",
      "check": "llm",
      "keywords": [
        "成立以来",
        "成立至今",
        "运作以来"
      ],
      "severity": "high"
    },
    {
      "id": "R02",
      "source": "ZXGD",
      "article": "第四条第二款",
      "title": "业绩未同时展示比较基准",
      "description": "展示基金业绩时，须同时展示业绩比较基准的表现。",
      "check": "llm",
      "keywords": [
        "收益率",
        "涨幅",
        "回报",
        "净值增长"
      ],
      "severity": "high"
    },
    {
      "id": "R03",
      "source": "ZXGD",
      "article": "第四条第二款",
      "title": "业绩展示期间短于 6 个月",
      "description": "展示的业绩期间不得短于 6 个月（如只展示近 1 个月、近 3 个月）。",
      "check": "llm",
      "keywords": [
        "近一月",
        "近1月",
        "近三月",
        "近3月",
        "近一周",
        "今年以来"
      ],
      "severity": "high"
    },
    {
      "id": "R04",
      "source": "ZXGD",
      "article": "第四条（一）至（三）项",
      "title": "业绩期间口径不符",
      "description": "合同生效 6 个月至 1 年按生效日起算；1 至 5 年须含生效当年起所有完整会计年度；5 年以上须含最近 5 个完整会计年度。只挑部分年度展示即违规。",
      "check": "llm",
      "keywords": [
        "年度",
        "年收益"
      ],
      "severity": "medium"
    },
    {
      "id": "R05",
      "source": "ZXGD",
      "article": "第四条（四）项",
      "title": "投资目标或基金经理变更未特别说明",
      "description": "展示期间内投资目标、范围、策略或基金经理发生变更的，须特别说明。正文仅顺带提及变更不算特别说明，须明确提示所展示业绩中哪些期间是在变更前取得的。",
      "check": "llm",
      "keywords": [
        "基金经理",
        "转型",
        "变更"
      ],
      "severity": "medium"
    },
    {
      "id": "R06",
      "source": "ZXGD",
      "article": "第五条（二）项",
      "title": "引用数据未注明来源",
      "description": "引用的统计数据须准确并注明出处。",
      "check": "llm",
      "keywords": [
        "%",
        "排名",
        "数据显示"
      ],
      "severity": "medium"
    },
    {
      "id": "R07",
      "source": "ZXGD",
      "article": "第五条（二）项",
      "title": "引用模拟、未发生或未经核实的数据",
      "description": "不得引用未经核实、尚未发生或者模拟的数据（定投模拟仅在完全满足 R08 时才豁免；不满足 R08 的定投模拟同时违反本条）。按【今天日期】判断数据是否已发生。",
      "check": "llm",
      "keywords": [
        "模拟",
        "测算",
        "假设",
        "回测",
        "预计"
      ],
      "severity": "high"
    },
    {
      "id": "R08",
      "source": "ZXGD",
      "article": "第五条（二）项",
      "title": "定投模拟不合规",
      "description": "定期定额等模拟历史收益须使用有代表性的指数、较长期间，标明年复合收益率，说明数据来源、计算方法与公式，并附风险提示。",
      "check": "llm",
      "keywords": [
        "定投",
        "定期定额"
      ],
      "severity": "medium"
    },
    {
      "id": "R09",
      "source": "ZXGD",
      "article": "第六条第一款",
      "title": "缺少“过往业绩不预示未来”声明",
      "description": "展示业绩须显著声明基金过往业绩不预示未来表现，管理人管理的其他基金业绩不构成本基金业绩保证。",
      "check": "llm",
      "keywords": [],
      "severity": "high"
    },
    {
      "id": "R10",
      "source": "ZXGD",
      "article": "第六条第一款",
      "title": "明示或暗示承诺未来收益",
      "description": "不得明示或暗示基金未来收益。",
      "check": "llm",
      "keywords": [
        "一定能",
        "必将",
        "稳稳",
        "跑赢",
        "翻倍"
      ],
      "severity": "high"
    },
    {
      "id": "R11",
      "source": "ZXGD",
      "article": "第六条第二款",
      "title": "基金经理业绩挑选产品或期间",
      "description": "展示基金经理过往业绩须如实说明其任职角色，原则上展示其管理的全部同类产品，不得挑选产品或期间。",
