LITELLM_BASE_URL=https://llm.corlin.cn
LITELLM_API_KEY=
HIAGENT_MODEL_CHEAP=
HIAGENT_MODEL_STRONG=
# 聊天可选模型从网关读取；可选设置默认模型别名，不填则使用初筛模型。
# PARLEYWISE_DEFAULT_CHAT_MODEL=deepseek-v4-pro
# 复核工作台（可选）
# HIAGENT_DATA_DIR=/var/lib/hiagent   # 数据库位置，默认 app/data
# HIAGENT_SECURE_COOKIE=1             # 经 HTTPS 访问时打开
# PARLEYWISE_INVITE_CODE=              # 可选：设置强随机邀请码后允许注册；留空关闭
